# Hostnames postgres, data-pipeline and ml-models resolve only inside Docker Compose.
# For a bare local run (scripts/run_local.sh) leave DATABASE_URL empty; the backend
# defaults to http://127.0.0.1:8001 (data-pipeline) and http://127.0.0.1:8002 (ml-models).
DATABASE_URL=postgresql://terrascope:terrascope@postgres:5432/terrascope
SATELLITE_PROVIDER=appeears
SATELLITE_DEMO_FALLBACK=true
NASA_APPEEARS_USERNAME=your_earthdata_username
NASA_APPEEARS_PASSWORD=your_earthdata_password
# Optional: if set, this bearer token is used directly and takes precedence
# over username/password. It must be accepted by the AppEEARS API.
NASA_APPEEARS_TOKEN=
NASA_APPEEARS_API_URL=https://appeears.earthdatacloud.nasa.gov/api
# Confirm the product and layer names in your AppEEARS catalog/task UI.
NASA_APPEEARS_PRODUCT=HLSS30.020
NASA_APPEEARS_B04_LAYER=B04
NASA_APPEEARS_B08_LAYER=B08
NASA_APPEEARS_B11_LAYER=B11
NASA_APPEEARS_CLOUD_LAYER=
NASA_APPEEARS_POLL_SECONDS=10
NASA_APPEEARS_MAX_WAIT_SECONDS=150
TERRASCOPE_SATELLITE_CACHE_PATH=.cache/terrascope_satellite.json
GROQ_API_KEY=demo-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
NOMINATIM_USER_AGENT=terrascope-local-demo/0.1.0

# --- Evidence and AI budgets -------------------------------------------------
# Groq is optional decoration on a deterministic verdict; these keep a slow
# provider from stalling the report. The backend read timeout must exceed them.
GROQ_GROUNDED_TIMEOUT_SECONDS=15
GROQ_EXPLANATION_TIMEOUT_SECONDS=12
EVALUATE_READ_TIMEOUT_SECONDS=90

# RERA seed CSV (district-level candidate evidence only). See data-pipeline/data/raw/README.md
RERA_SEED_PATH=/app/data/raw/maharera_seed.csv

# --- Land valuation ----------------------------------------------------------
# Train with: python -m valuation.train <price_csv> --out valuation/artifacts/land_price_model.joblib
# See valuation/README.md for the CSV contract and dataset requirements.
VALUATION_MODEL_PATH=/app/valuation/artifacts/land_price_model.joblib
# A parcel needs this many observations within this radius or it is refused.
VALUATION_MAX_SUPPORT_DISTANCE_KM=25
VALUATION_MIN_SUPPORTING_OBSERVATIONS=5
# Demo only: let a model trained on the synthetic fixture quote (labelled) prices.
# Leave false so no invented price is ever shown.
VALUATION_ALLOW_SYNTHETIC=false
