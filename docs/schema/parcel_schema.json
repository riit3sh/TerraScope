{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terrascope.local/schema/parcel-record.json",
  "title": "ParcelRecord",
  "description": "A TerraScope land due-diligence record for an analysis parcel.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "parcel_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "village": {
          "type": [
            "string",
            "null"
          ]
        },
        "district": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "pincode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "$ref": "#/$defs/polygonCoordinates"
        }
      }
    },
    "geometry_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "area_m2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "area_acres": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "perimeter_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "boundary_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "user_drawn",
            "imported",
            "estimated",
            "unknown",
            null
          ]
        },
        "boundary_verified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "land_records": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "survey_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownership_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "freehold",
            "leasehold",
            "disputed",
            "unknown",
            null
          ]
        },
        "title_clear": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "encumbrance_flag": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_document_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "zoning_verified": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Land-use zoning confirmed against an official record. Null = not verified."
        },
        "approvals_verified": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Required layout/building approvals confirmed against official records. Null = not verified."
        }
      }
    },
    "rera": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "is_rera_project": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rera_registration_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "promoter_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "registered_completion_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "satellite": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "imagery_dates": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "ndvi_trend": {
          "$ref": "#/$defs/timeSeries"
        },
        "ndbi_trend": {
          "$ref": "#/$defs/timeSeries"
        },
        "change_detected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "change_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "construction_growth",
            "vegetation_loss",
            "vegetation_gain",
            "no_change",
            "inconclusive",
            "insufficient_evidence",
            null
          ]
        },
        "change_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "change_method": {
          "type": [
            "object",
            "null"
          ],
          "description": "How change_type was decided (method, same-season pairs, paired differences, thresholds). Absent on snapshots made with statistical_change_v1."
        },
        "observations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object"
          },
          "description": "Per-observation provenance: scene id, season anchor, clear pixels, cloud fractions, reflectance offset."
        },
        "collection": {
          "type": [
            "object",
            "null"
          ],
          "description": "How scenes were searched and selected (algorithm version, anchors, scenes matched/read/rejected)."
        }
      }
    },
    "land_cover_history": {
      "type": [
        "object",
        "null"
      ],
      "description": "Annual land cover 2017-2023 (Impact Observatory / Esri 10 m) for the parcel and the land within 1 km and 1-3 km of it, with built-area trends. Evidence for the area-growth factor."
    },
    "infrastructure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "nearest_road_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "nearest_road_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_school_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "nearest_road_route_distance_m": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional Google driving distance from the parcel centroid to the nearest mapped road point."
        },
        "nearest_road_route_duration_s": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "nearest_school_route_distance_m": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional Google driving distance from the parcel centroid to the nearest mapped school point."
        },
        "nearest_school_route_duration_s": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "nearest_road_lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "nearest_road_lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "nearest_school_lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "nearest_school_lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "nearest_road_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_road_access_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_road_surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_school_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "distance_measurement": {
          "type": [
            "string",
            "null"
          ]
        },
        "road_access_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "road_access_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "nearest_hospital_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "nearest_hospital_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_bus_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "nearest_bus_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_rail_station_distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "nearest_rail_station_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_bus_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_rail_station_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "search_radius_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "nearest_road_distance_from_boundary_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Straight line from the drawn boundary; 0 when a mapped way touches or crosses it."
        },
        "nearest_road_boundary_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_road_boundary_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearest_school_distance_from_boundary_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "nearest_school_boundary_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "layer_status": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "enum": [
              "installed",
              "not_installed"
            ]
          },
          "description": "Per OSM layer: installed in the store this parcel was read from, or not installed (unknown, never 'none mapped')."
        }
      }
    },
    "public_land": {
      "type": [
        "object",
        "null"
      ],
      "description": "Mapped public facilities and possibly restricted land touching or near the parcel (OpenStreetMap): facility type, overlap measured on the parcel geometry, and any operator/ownership tag. Mapping evidence only, never ownership."
    },
    "coast": {
      "type": [
        "object",
        "null"
      ],
      "description": "Distance from the boundary to the OpenStreetMap coastline; 'coastal' within the 10 km band. Decides only whether coastal flooding is relevant; never a hazard assessment."
    },
    "risk": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "flood_risk_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "flood_risk_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "elevation_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "legal_risk_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "accessibility_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "terrain_relative_elevation_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "terrain_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "flood_assessment_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "assessed",
            "unavailable",
            null
          ]
        }
      }
    },
    "opportunity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "growth_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "infra_growth_trend": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rising",
            "stable",
            "declining",
            null
          ]
        }
      }
