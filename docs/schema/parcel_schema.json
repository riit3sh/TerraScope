        },
        "pre_purchase_checks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "What TerraScope could not check and the buyer must, before paying (title, encumbrance, approvals; changes on the plot)."
        },
        "findings": {
          "type": [
            "array",
            "null"
          ],
          "description": "One row per thing a buyer needs to know, red flags first. Built from the snapshot; adds no new figures.",
