            null,
            "RESTRICTED"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reasoning_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "citations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "claim": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Page or section inside the cited source, where extraction supports it."
