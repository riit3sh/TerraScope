              ],
              "minimum": 0,
              "maximum": 100
            },
            "accessibility_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "flood_safety_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "preferences": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "road_importance": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "low",
                "medium",
                "high",
                null
              ]
            },
            "school_importance": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "low",
                "medium",
                "high",
                null
              ]
            },
            "max_road_distance_m": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
