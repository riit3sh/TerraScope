                  "string",
                  "null"
                ]
              },
              "limitations": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "weight_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "checklist": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "details": {
                "type": [
                  "object",
                  "null"
                ],
